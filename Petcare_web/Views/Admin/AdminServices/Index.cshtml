@model List<Petcare_web.Models.DTO.DichVuDTO>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách dịch vụ";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm dịch vụ
        </a>
    </div>

    <div class="card-body">
        <table>
            <thead>
                <tr>
                    <th>Mã DV</th>
                    <th>Tên dịch vụ</th>
                    <th>Giá (VNĐ)</th>
                    <th>Thời gian (phút)</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var service in Model)
                    {
                        <tr>
                            <td>#@service.MaDichVu</td>
                            <td>@service.TenDichVu</td>
                            <td>@service.Gia.ToString("N0")</td>
                            <td>@service.ThoiGian</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@service.MaDichVu" class="btn btn-secondary btn-sm">
                                    Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@service.MaDichVu" class="btn btn-danger btn-sm">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Chưa có dịch vụ nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Phân trang *@
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer" style="text-align: center;">
            <nav aria-label="Pagination">
                <ul class="pagination justify-content-center mb-0" style="display: inline-flex;">
                    @* Nút Previous *@
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })" aria-label="Previous">
                            <span aria-hidden="true">&laquo; Trước</span>
                        </a>
                    </li>

                    @* Hiển thị các số trang *@
                    @{
                        int currentPage = ViewBag.CurrentPage;
                        int totalPages = ViewBag.TotalPages;
                        int startPage = Math.Max(1, currentPage - 1);
                        int endPage = Math.Min(totalPages, currentPage + 1);

                        // Trang đầu
                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { pageNumber = 1, pageSize = ViewBag.PageSize })">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        // Các trang giữa
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = ViewBag.PageSize })">@i</a>
                            </li>
                        }

                        // Trang cuối
                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { pageNumber = totalPages, pageSize = ViewBag.PageSize })">@totalPages</a>
                            </li>
                        }
                    }

                    @* Nút Next *@
                    <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })" aria-label="Next">
                            <span aria-hidden="true">Sau &raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>

            @* Thông tin trang *@
            <div class="text-center mt-3 text-muted">
                <small>Trang @ViewBag.CurrentPage / @ViewBag.TotalPages (Tổng @ViewBag.TotalItems dịch vụ)</small>
            </div>
        </div>
    }
</div>

<style>
    /* Pagination styling */
    .pagination {
        display: flex;
        flex-wrap: wrap;
        padding-left: 0;
        list-style: none;
        margin: 0;
        gap: 4px;
    }
    
    .page-item {
        display: inline-block;
    }
    
    .page-link {
        position: relative;
        display: block;
        color: #2563eb;
        text-decoration: none;
        background-color: #fff;
        border: 1px solid #e5e7eb;
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        transition: all 0.2s;
    }
    
    .page-link:hover {
        background-color: #eff6ff;
        border-color: #2563eb;
        color: #1d4ed8;
        z-index: 2;
    }
    
    .page-item.active .page-link {
        background-color: #2563eb;
        border-color: #2563eb;
        color: white;
        z-index: 3;
    }
    
    .page-item.disabled .page-link {
        color: #9ca3af;
        pointer-events: none;
        background-color: #f9fafb;
        border-color: #e5e7eb;
    }
    
    .page-item:not(:first-child) .page-link {
        margin-left: -1px;
    }
</style>