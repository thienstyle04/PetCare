@model Petcare_web.Models.DTO.DichVuDTO
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm mới Dịch vụ";
}

<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 class="card-title">🛠️ @ViewData["Title"]</h3>
        <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@ViewData["ErrorMessage"]</div>
            }

            <div class="form-group">
                <label asp-for="TenDichVu" class="form-label">Tên dịch vụ</label>
                <input asp-for="TenDichVu" class="form-input" />
                <span asp-validation-for="TenDichVu" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MoTa" class="form-label">Mô tả</label>
                <textarea asp-for="MoTa" class="form-textarea" rows="3"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="form-group">
                    <label asp-for="Gia" class="form-label">Giá (VNĐ)</label>
                    <input asp-for="Gia" type="number" class="form-input" />
                    <span asp-validation-for="Gia" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ThoiGian" class="form-label">Thời gian ước tính (phút)</label>
                    <input asp-for="ThoiGian" type="number" class="form-input" />
                    <span asp-validation-for="ThoiGian" class="text-danger"></span>
                </div>
            </div>

            <div style="margin-top: 30px; display: flex; gap: 12px;">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}