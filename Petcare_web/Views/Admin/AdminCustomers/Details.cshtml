@model Petcare_web.Models.DTO.KhachHangDTO

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết khách hàng";
    var pets = ViewBag.Pets as List<Petcare_web.Models.DTO.ThuCungDTO>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-person-circle"></i> @ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row">
                        <!-- Customer Information Section -->
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0"><i class="bi bi-person-badge"></i> Thông tin khách hàng</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tbody>
                                            <tr>
                                                <th style="width: 40%;">Mã khách hàng:</th>
                                                <td><strong>#@Model.MaKhachHang</strong></td>
                                            </tr>
                                            <tr>
                                                <th>Họ tên:</th>
                                                <td>@Model.HoTen</td>
                                            </tr>
                                            <tr>
                                                <th>Số điện thoại:</th>
                                                <td>@(Model.SoDienThoai ?? "Chưa cập nhật")</td>
                                            </tr>
                                            <tr>
                                                <th>Email:</th>
                                                <td>@(Model.Email ?? "Chưa cập nhật")</td>
                                            </tr>
                                            <tr>
                                                <th>Địa chỉ:</th>
                                                <td>@(Model.DiaChi ?? "Chưa cập nhật")</td>
                                            </tr>
                                            <tr>
                                                <th>Ngày sinh:</th>
                                                <td>
                                                    @if (Model.NgaySinh.HasValue)
                                                    {
                                                        @Model.NgaySinh.Value.ToString("dd/MM/yyyy")
                                                    }
                                                    else
                                                    {
                                                        <text>Chưa cập nhật</text>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Ngày tạo:</th>
                                                <td>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                            </tr>
                                            @if (Model.MaNguoiDung.HasValue)
                                            {
                                                <tr>
                                                    <th>Mã người dùng:</th>
                                                    <td>#@Model.MaNguoiDung</td>
                                                </tr>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.TenDangNhap))
                                            {
                                                <tr>
                                                    <th>Tên đăng nhập:</th>
                                                    <td>@Model.TenDangNhap</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Pet Statistics Section -->
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Thống kê</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col-md-12 mb-3">
                                            <div class="card bg-light">
                                                <div class="card-body">
                                                    <h2 class="text-primary mb-0">
                                                        @(pets?.Count ?? 0)
                                                    </h2>
                                                    <p class="text-muted mb-0">Thú cưng</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @if (pets != null && pets.Any())
                                    {
                                        <hr />
                                        <h6 class="text-muted mb-2">Phân loại thú cưng:</h6>
                                        <ul class="list-unstyled">
                                            @foreach (var petType in pets.GroupBy(p => p.Loai ?? "Không xác định"))
                                            {
                                                <li class="mb-1">
                                                    <i class="bi bi-dot"></i>
                                                    <strong>@petType.Key:</strong> @petType.Count() con
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pets List Section -->
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-header bg-warning text-dark">
                                    <h5 class="mb-0">
                                        <i class="bi bi-heart-fill"></i> 
                                        Danh sách thú cưng (@(pets?.Count ?? 0))
                                    </h5>
                                </div>
                                <div class="card-body">
                                    @if (ViewData["PetsError"] != null)
                                    {
                                        <div class="alert alert-warning" role="alert">
                                            <i class="bi bi-exclamation-triangle"></i> @ViewData["PetsError"]
                                        </div>
                                    }
                                    
                                    @if (pets != null && pets.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-striped table-hover align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Mã TC</th>
                                                        <th>Tên thú cưng</th>
                                                        <th>Loại</th>
                                                        <th>Giống</th>
                                                        <th>Giới tính</th>
                                                        <th>Tuổi</th>
                                                        <th>Cân nặng</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var pet in pets)
                                                    {
                                                        <tr>
                                                            <td><strong>#@pet.MaThuCung</strong></td>
                                                            <td>@pet.TenThuCung</td>
                                                            <td>@(pet.Loai ?? "-")</td>
                                                            <td>@(pet.Giong ?? "-")</td>
                                                            <td>@(pet.GioiTinh ?? "-")</td>
                                                            <td>@(pet.Tuoi.HasValue ? pet.Tuoi.Value.ToString() + " tuổi" : "-")</td>
                                                            <td>@(pet.CanNang.HasValue ? pet.CanNang.Value.ToString("F2") + " kg" : "-")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info" role="alert">
                                            <i class="bi bi-info-circle"></i> Khách hàng chưa có thú cưng nào.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                                </a>
                                <div>
                                    <a asp-action="Edit" asp-route-id="@Model.MaKhachHang" class="btn btn-warning">
                                        <i class="bi bi-pencil"></i> Chỉnh sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@Model.MaKhachHang" 
                                       class="btn btn-danger"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}
