@model Petcare_web.Models.DTO.DanhGiaDTO
@{
    ViewData["Title"] = "Đánh giá dịch vụ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var lichHen = ViewBag.LichHen as Petcare_web.Models.DTO.LichHenDTO;
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title mb-0">Đánh giá dịch vụ</h3>
        </div>
        <div class="card-body p-4">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (lichHen != null)
            {
                <div class="alert alert-info mb-4">
                    <h5 class="alert-heading mb-3">
                        <i class="bi bi-info-circle"></i> Thông tin lịch hẹn
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Dịch vụ:</strong> @lichHen.TenDichVu</p>
                            <p class="mb-0"><strong>Thú cưng:</strong> @lichHen.TenThuCung</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Ngày giờ hẹn:</strong> @lichHen.NgayGioHen.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-0"><strong>Tổng tiền:</strong> <span class="text-primary fw-bold">@(lichHen.TongTien?.ToString("N0") ?? "0") VNĐ</span></p>
                        </div>
                    </div>
                </div>
            }

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaLichHen" />
                <input type="hidden" asp-for="MaKhachHang" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Đánh giá của bạn <span class="text-danger">*</span></label>
                    <div class="rating-options">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="DiemSo" id="rating1" value="1" @(Model?.DiemSo == 1 ? "checked" : "") required>
                            <label class="form-check-label" for="rating1">
                                ⭐ 1 - Rất tệ
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="DiemSo" id="rating2" value="2" @(Model?.DiemSo == 2 ? "checked" : "") required>
                            <label class="form-check-label" for="rating2">
                                ⭐⭐ 2 - Tệ
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="DiemSo" id="rating3" value="3" @(Model?.DiemSo == 3 ? "checked" : "") required>
                            <label class="form-check-label" for="rating3">
                                ⭐⭐⭐ 3 - Bình thường
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="DiemSo" id="rating4" value="4" @(Model?.DiemSo == 4 ? "checked" : "") required>
                            <label class="form-check-label" for="rating4">
                                ⭐⭐⭐⭐ 4 - Tốt
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="DiemSo" id="rating5" value="5" @(Model?.DiemSo == 5 ? "checked" : "") required>
                            <label class="form-check-label" for="rating5">
                                ⭐⭐⭐⭐⭐ 5 - Rất tốt
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="DiemSo" class="text-danger d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BinhLuan" class="form-label fw-bold">Nhận xét của bạn</label>
                    <textarea asp-for="BinhLuan" class="form-control" rows="5" 
                              placeholder="Chia sẻ trải nghiệm của bạn về dịch vụ... (Không bắt buộc)"
                              maxlength="1000"></textarea>
                    <small class="form-text text-muted">Tối đa 1000 ký tự</small>
                    <span asp-validation-for="BinhLuan" class="text-danger"></span>
                </div>

                <div class="alert alert-light border mb-4">
                    <i class="bi bi-lightbulb text-warning"></i> <strong>Gợi ý:</strong>
                    <ul class="mb-0 mt-2 ps-4">
                        <li>Chất lượng dịch vụ có đạt yêu cầu không?</li>
                        <li>Nhân viên có thân thiện và chuyên nghiệp không?</li>
                        <li>Thú cưng của bạn có được chăm sóc tốt không?</li>
                        <li>Bạn có muốn sử dụng dịch vụ này lần sau không?</li>
                    </ul>
                </div>

                <div class="d-flex gap-2 pt-3 border-top">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send"></i> Gửi đánh giá
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
