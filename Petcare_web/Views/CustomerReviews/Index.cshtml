@model List<Petcare_web.Models.DTO.LichHenReviewDTO>
@{
    ViewData["Title"] = "Đánh giá dịch vụ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h3 class="card-title mb-0">Đánh giá dịch vụ đã sử dụng</h3>
        </div>
        <div class="card-body p-4">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Ngày hẹn</th>
                                <th>Giờ hẹn</th>
                                <th>Dịch vụ</th>
                                <th>Thú cưng</th>
                                <th>Giá</th>
                                <th>Đánh giá</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NgayHen.ToString("dd/MM/yyyy")</td>
                                    <td>@item.GioHen.ToString(@"hh\:mm")</td>
                                    <td>@item.TenDichVu</td>
                                    <td>@item.TenThuCung</td>
                                    <td>@item.GiaDichVu.ToString("N0") VNĐ</td>
                                    <td>
                                        @if (item.DaDanhGia)
                                        {
                                            <div>
                                                <div class="text-warning">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= item.DiemSo)
                                                        {
                                                            <i class="bi bi-star-fill"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-star"></i>
                                                        }
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.BinhLuan))
                                                {
                                                    <small class="text-muted d-block mt-1" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                        "@item.BinhLuan"
                                                    </small>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Chưa đánh giá</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!item.DaDanhGia)
                                        {
                                            <a asp-action="Create" asp-route-maLichHen="@item.MaLichHen" class="btn btn-sm btn-primary">
                                                Đánh giá
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> Đã đánh giá</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-info mt-3 mb-0">
                    <i class="bi bi-info-circle"></i> <strong>Lưu ý:</strong> 
                    Bạn chỉ có thể đánh giá các dịch vụ đã hoàn thành. Đánh giá của bạn giúp chúng tôi cải thiện chất lượng dịch vụ.
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle"></i>
                    Bạn chưa có dịch vụ nào đã hoàn thành để đánh giá.
                </div>
            }
        </div>
    </div>
</div>
