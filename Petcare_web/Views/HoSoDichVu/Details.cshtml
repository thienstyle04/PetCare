@model Petcare_web.Models.DTO.HoSoDichVuDTO

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Chi tiết Hồ sơ Dịch vụ";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Chi tiết Hồ sơ #@Model.MaHoSo</h3>
    </div>

    <div class="card-body">
        <!-- Thông tin cơ bản -->
        <div style="margin-bottom: 30px;">
            <h5 style="color: #667eea; margin-bottom: 15px; font-weight: 600;">Thông tin chung</h5>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px;">
                <div class="info-box">
                    <strong>Mã lịch hẹn:</strong> 
                    <span style="color: #2563eb; font-weight: 600;">#@Model.MaLichHen</span>
                </div>
                <div class="info-box">
                    <strong>Nhân viên thực hiện:</strong> 
                    <span>@(Model.TenNhanVien ?? "Chưa có thông tin")</span>
                </div>
                <div class="info-box">
                    <strong>Ngày tạo:</strong> 
                    <span>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- Hình ảnh trước/sau -->
        <div style="margin-bottom: 30px;">
            <h5 style="color: #667eea; margin-bottom: 15px; font-weight: 600;">📸 Hình ảnh Trước/Sau</h5>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                <div style="border: 2px solid #e5e7eb; border-radius: 8px; padding: 15px; background: #f9fafb;">
                    <div style="font-weight: 600; margin-bottom: 10px; color: #374151;">Ảnh trước khi thực hiện</div>
                    @if (!string.IsNullOrEmpty(Model.AnhTruoc))
                    {
                        <img src="@Model.AnhTruoc" alt="Ảnh trước" style="width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" />
                    }
                    else
                    {
                        <div style="padding: 60px 20px; text-align: center; background: #f3f4f6; border-radius: 8px; color: #9ca3af;">
                            Chưa có ảnh
                        </div>
                    }
                </div>
                <div style="border: 2px solid #e5e7eb; border-radius: 8px; padding: 15px; background: #f9fafb;">
                    <div style="font-weight: 600; margin-bottom: 10px; color: #374151;">Ảnh sau khi thực hiện</div>
                    @if (!string.IsNullOrEmpty(Model.AnhSau))
                    {
                        <img src="@Model.AnhSau" alt="Ảnh sau" style="width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" />
                    }
                    else
                    {
                        <div style="padding: 60px 20px; text-align: center; background: #f3f4f6; border-radius: 8px; color: #9ca3af;">
                            Chưa có ảnh
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Ghi chú -->
        <div style="margin-bottom: 20px;">
            <h5 style="color: #667eea; margin-bottom: 15px; font-weight: 600;">Ghi chú dịch vụ</h5>
            <div style="background: #f9fafb; border-left: 4px solid #667eea; padding: 15px; border-radius: 8px;">
                @if (!string.IsNullOrEmpty(Model.GhiChuDichVu))
                {
                    <p style="margin: 0; color: #374151;">@Model.GhiChuDichVu</p>
                }
                else
                {
                    <p style="margin: 0; color: #9ca3af; font-style: italic;">Không có ghi chú</p>
                }
            </div>
        </div>

        <!-- Nút hành động -->
        <div style="margin-top: 30px;">
            <a asp-action="Index" class="btn btn-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>
