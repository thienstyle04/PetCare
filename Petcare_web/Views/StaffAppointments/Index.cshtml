@model List<Petcare_web.Models.DTO.LichHenDTO>

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Danh sách lịch hẹn";
}

<div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã LH</th>
                        <th>Khách hàng</th>
                        <th>Thú cưng</th>
                        <th>Nhân viên</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.MaLichHen</td>
                                <td>@item.TenKhachHang</td>
                                <td>@item.TenThuCung</td>
                                <td>@item.TenNhanVien</td>
                                <td>@item.NgayGioHen.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.TrangThai == "Chờ xác nhận")
                                    {
                                        <span class="badge bg-warning text-dark">@item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == "Đã xác nhận")
                                    {
                                        <span class="badge bg-info text-white">@item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == "Hoàn thành")
                                    {
                                        <span class="badge bg-success">@item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == "Đã hủy")
                                    {
                                        <span class="badge bg-danger">@item.TrangThai</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.TrangThai</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai == "Chờ xác nhận")
                                    {
                                        <form asp-action="UpdateStatus" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.MaLichHen" />
                                            <input type="hidden" name="status" value="Đã xác nhận" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                Xác nhận
                                            </button>
                                        </form>
                                    }
                                    @if (item.TrangThai == "Đã xác nhận")
                                    {
                                        <form asp-action="UpdateStatus" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.MaLichHen" />
                                            <input type="hidden" name="status" value="Hoàn thành" />
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                Hoàn thành
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">Chưa có lịch hẹn nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>