@model Petcare_web.Models.DTO.ThuCungDTO
@{
    ViewData["Title"] = "Xóa thú cưng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Xác nhận xóa thú cưng</h3>
    </div>
    <div class="card-body">
        <div class="alert" style="background: #fef3c7; border: 1px solid #fde68a; color: #92400e; margin-bottom: 24px;">
            <strong>⚠️ Cảnh báo:</strong> Bạn có chắc chắn muốn xóa thú cưng này không? Hành động này không thể hoàn tác!
        </div>

        <div style="background: #f9fafb; padding: 24px; border-radius: 8px; margin-bottom: 24px;">
            <div class="pet-icon" style="text-align: center; font-size: 64px; margin-bottom: 16px;">
                @(Model.Loai == "Chó" ? "🐕" : Model.Loai == "Mèo" ? "🐱" : "🐾")
            </div>
            
            <div style="text-align: center; margin-bottom: 24px;">
                <h2 style="font-size: 24px; color: #1f2937; margin-bottom: 8px;">@Model.TenThuCung</h2>
                @if (!string.IsNullOrEmpty(Model.Loai) || !string.IsNullOrEmpty(Model.Giong))
                {
                    <p style="font-size: 16px; color: #6b7280;">
                        @if (!string.IsNullOrEmpty(Model.Loai))
                        {
                            @Model.Loai
                        }
                        @if (!string.IsNullOrEmpty(Model.Giong))
                        {
                            <text> • @Model.Giong</text>
                        }
                    </p>
                }
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                @if (!string.IsNullOrEmpty(Model.Loai))
                {
                    <div>
                        <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Loại</div>
                        <div style="font-size: 14px; color: #1f2937; font-weight: 500;">@Model.Loai</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Giong))
                {
                    <div>
                        <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Giống</div>
                        <div style="font-size: 14px; color: #1f2937; font-weight: 500;">@Model.Giong</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.GioiTinh))
                {
                    <div>
                        <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Giới tính</div>
                        <div style="font-size: 14px; color: #1f2937; font-weight: 500;">@Model.GioiTinh</div>
                    </div>
                }
                
                @if (Model.Tuoi.HasValue && Model.Tuoi > 0)
                {
                    <div>
                        <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Tuổi</div>
                        <div style="font-size: 14px; color: #1f2937; font-weight: 500;">@Model.Tuoi tuổi</div>
                    </div>
                }
                
                @if (Model.CanNang.HasValue && Model.CanNang > 0)
                {
                    <div>
                        <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Cân nặng</div>
                        <div style="font-size: 14px; color: #1f2937; font-weight: 500;">@Model.CanNang kg</div>
                    </div>
                }
                
                @if (Model.NamSinh.HasValue)
                {
                    <div>
                        <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Năm sinh</div>
                        <div style="font-size: 14px; color: #1f2937; font-weight: 500;">@Model.NamSinh</div>
                    </div>
                }
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" name="id" value="@Model.MaThuCung" />
            
            <div style="display: flex; gap: 12px;">
                <a asp-action="Index" class="btn btn-secondary" style="flex: 1;">Hủy</a>
                <button type="submit" class="btn" style="flex: 1; background: #dc2626; color: white;">
                    Xác nhận xóa
                </button>
            </div>
        </form>
    </div>
</div>
