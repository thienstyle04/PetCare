@model Petcare_web.Models.DTO.KhachHangDTO
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">Hồ sơ cá nhân</h3>
            <div>
                <a asp-action="Edit" class="btn btn-primary me-2">Chỉnh sửa</a>
                <a asp-action="ChangePassword" class="btn btn-secondary">Đổi mật khẩu</a>
            </div>
        </div>
        <div class="card-body p-4">
            @if (Model != null)
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="profile-section">
                            <h5 class="section-title mb-3">Thông tin cá nhân</h5>
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="fw-bold py-2" style="width: 150px;">Mã khách hàng:</td>
                                        <td class="py-2">#KH@(Model.MaKhachHang)</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold py-2">Họ và tên:</td>
                                        <td class="py-2">@Model.HoTen</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold py-2">Số điện thoại:</td>
                                        <td class="py-2">@(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold py-2">Ngày sinh:</td>
                                        <td class="py-2">
                                            @if (Model.NgaySinh.HasValue)
                                            {
                                                @Model.NgaySinh.Value.ToString("dd/MM/yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa cập nhật</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold py-2">Địa chỉ:</td>
                                        <td class="py-2">
                                            @if (!string.IsNullOrEmpty(Model.DiaChi))
                                            {
                                                @Model.DiaChi
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa cập nhật</span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="profile-section">
                            <h5 class="section-title mb-3">Thông tin tài khoản</h5>
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="fw-bold py-2" style="width: 150px;">Tên đăng nhập:</td>
                                        <td class="py-2">
                                            @if (!string.IsNullOrEmpty(Model.TenDangNhap))
                                            {
                                                @Model.TenDangNhap
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa cập nhật</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold py-2">Email:</td>
                                        <td class="py-2">
                                            @if (!string.IsNullOrEmpty(Model.Email))
                                            {
                                                @Model.Email
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa cập nhật</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold py-2">Ngày tạo:</td>
                                        <td class="py-2">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <div class="alert alert-info mb-0">
                            <strong>Lưu ý:</strong> Nếu bạn cần thay đổi email hoặc tên đăng nhập, vui lòng liên hệ với quản trị viên.
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Không tìm thấy thông tin hồ sơ. Vui lòng đăng nhập lại.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .profile-section {
        border-left: 3px solid #2563eb;
        padding-left: 20px;
    }
    .section-title {
        color: #2563eb;
        font-weight: 600;
    }
</style>
