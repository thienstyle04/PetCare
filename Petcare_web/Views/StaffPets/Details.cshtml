@model Petcare_web.Models.DTO.ThuCungDTO

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Chi tiết thú cưng";
    var customer = ViewBag.Customer as Petcare_web.Models.DTO.KhachHangDTO;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-clipboard-data"></i> @ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row">
                        <!-- Pet Information Section -->
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0"><i class="bi bi-heart-fill"></i> Thông tin thú cưng</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tbody>
                                            <tr>
                                                <th style="width: 40%;">Mã thú cưng:</th>
                                                <td><strong>#@Model.MaThuCung</strong></td>
                                            </tr>
                                            <tr>
                                                <th>Tên thú cưng:</th>
                                                <td>@Model.TenThuCung</td>
                                            </tr>
                                            <tr>
                                                <th>Loại:</th>
                                                <td>@(Model.Loai ?? "Chưa xác định")</td>
                                            </tr>
                                            <tr>
                                                <th>Giống:</th>
                                                <td>@(Model.Giong ?? "Chưa xác định")</td>
                                            </tr>
                                            <tr>
                                                <th>Giới tính:</th>
                                                <td>@(Model.GioiTinh ?? "Chưa xác định")</td>
                                            </tr>
                                            <tr>
                                                <th>Ngày sinh:</th>
                                                <td>
                                                    @if (Model.NgaySinh.HasValue)
                                                    {
                                                        @Model.NgaySinh.Value.ToString("dd/MM/yyyy")
                                                    }
                                                    else if (Model.NamSinh.HasValue)
                                                    {
                                                        <text>Năm @Model.NamSinh.Value</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Chưa xác định</text>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Tuổi:</th>
                                                <td>@(Model.Tuoi.HasValue ? Model.Tuoi.Value.ToString() + " tuổi" : "Chưa xác định")</td>
                                            </tr>
                                            <tr>
                                                <th>Cân nặng:</th>
                                                <td>@(Model.CanNang.HasValue ? Model.CanNang.Value.ToString("F2") + " kg" : "Chưa xác định")</td>
                                            </tr>
                                            <tr>
                                                <th>Ghi chú:</th>
                                                <td>@(Model.ChuThich ?? "Không có")</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Customer Information Section -->
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="bi bi-person-circle"></i> Thông tin chủ sở hữu</h5>
                                </div>
                                <div class="card-body">
                                    @if (customer != null)
                                    {
                                        <table class="table table-borderless">
                                            <tbody>
                                                <tr>
                                                    <th style="width: 40%;">Mã khách hàng:</th>
                                                    <td><strong>#@customer.MaKhachHang</strong></td>
                                                </tr>
                                                <tr>
                                                    <th>Họ tên:</th>
                                                    <td>@customer.HoTen</td>
                                                </tr>
                                                <tr>
                                                    <th>Số điện thoại:</th>
                                                    <td>@(customer.SoDienThoai ?? "Chưa cập nhật")</td>
                                                </tr>
                                                <tr>
                                                    <th>Địa chỉ:</th>
                                                    <td>@(customer.DiaChi ?? "Chưa cập nhật")</td>
                                                </tr>
                                                <tr>
                                                    <th>Email:</th>
                                                    <td>@(customer.Email ?? "Chưa cập nhật")</td>
                                                </tr>
                                                <tr>
                                                    <th>Ngày sinh:</th>
                                                    <td>
                                                        @if (customer.NgaySinh.HasValue)
                                                        {
                                                            @customer.NgaySinh.Value.ToString("dd/MM/yyyy")
                                                        }
                                                        else
                                                        {
                                                            <text>Chưa cập nhật</text>
                                                        }
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <th>Ngày tạo:</th>
                                                    <td>@customer.NgayTao.ToString("dd/MM/yyyy")</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning" role="alert">
                                            <i class="bi bi-exclamation-triangle"></i> Không tìm thấy thông tin khách hàng.
                                        </div>
                                        @if (ViewData["CustomerError"] != null)
                                        {
                                            <p class="text-muted small">@ViewData["CustomerError"]</p>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}
