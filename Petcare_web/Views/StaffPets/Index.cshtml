@model List<Petcare_web.Models.DTO.ThuCungDTO>

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Danh sách thú cưng";
}

<div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã TC</th>
                        <th>Tên thú cưng</th>
                        <th>Giống</th>
                        <th>Tuổi</th>
                        <th>Cân nặng (kg)</th>
                        <th>Chủ sở hữu (Mã KH)</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var pet in Model)
                        {
                            <tr>
                                <td>#@pet.MaThuCung</td>
                                <td>@pet.TenThuCung</td>
                                <td>@(pet.Giong ?? "-")</td>
                                <td>@(pet.Tuoi.HasValue? pet.Tuoi.Value.ToString() : "-")</td>
                                <td>@(pet.CanNang.HasValue? pet.CanNang.Value.ToString("F2") : "-")</td>
                                <td>#@pet.MaKhachHang</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@pet.MaThuCung" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">Chưa có thú cưng nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>