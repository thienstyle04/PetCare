@model Petcare_web.Models.DTO.DichVuDTO

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Thêm dịch vụ mới";
}

<div class="page-content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Thêm dịch vụ mới</h3>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="TenDichVu">Tên dịch vụ</label>
                    <input asp-for="TenDichVu" class="form-control" />
                    <span asp-validation-for="TenDichVu" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="MoTa">Mô tả</label>
                    <textarea asp-for="MoTa" class="form-control"></textarea>
                </div>

                <div class="form-group">
                    <label for="Gia">Giá</label>
                    <input asp-for="Gia" class="form-control" type="number" step="1000" />
                </div>

                <div class="form-group">
                    <label for="ThoiGian">Thời gian (phút)</label>
                    <input asp-for="ThoiGian" class="form-control" type="number" />
                </div>

                <div class="form-group">
                    <label for="GhiChu">Ghi chú</label>
                    <input asp-for="GhiChu" class="form-control" />
                </div>

                <div class="form-group">
                    <label for="imageFile">Ảnh dịch vụ</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
